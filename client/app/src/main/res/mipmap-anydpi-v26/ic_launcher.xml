<?xml version="1.0" encoding="utf-8"?>
<!-- Adaptive icon: navy field behind the app's own artwork. The foreground is a bitmap per
     density, not a vector, because the drawing is a pen illustration and tracing it would lose
     the line work. Generated from the source art by bin/make-icons.py. -->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@drawable/ic_launcher_background" />
    <foreground android:drawable="@mipmap/ic_launcher_foreground" />
</adaptive-icon>
