<?xml version="1.0" encoding="utf-8"?>
<!-- Window background shown while the first activity inflates: flat app colour plus the mark,
     so the launch never flashes a white screen. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:drawable="@color/samp_bg" />
    <item
        android:drawable="@drawable/ic_splash_mark"
        android:gravity="center" />
</layer-list>
